# ---------------------------------------------------------------
# ربات انتشار ویدیو در اینستاگرام — نمونهٔ تنظیمات
# این فایل را به نام .env کپی کن و مقادیر را پر کن.
# این فایل هرگز نباید commit شود.
# ---------------------------------------------------------------

# --- اکانت (اجباری) ---
# شناسهٔ اکانت حرفه‌ای اینستاگرام (نه نام کاربری)
IG_USER_ID=
# توکن دسترسی بلندمدت (۶۰ روزه)
IG_ACCESS_TOKEN=
# اگر از «Instagram API with Instagram Login» استفاده می‌کنی:
# IG_GRAPH_BASE_URL=https://graph.instagram.com
IG_GRAPH_BASE_URL=https://graph.facebook.com
IG_GRAPH_VERSION=v23.0

# --- پوشه و متن پست ---
IG_MEDIA_DIR=media
IG_DEFAULT_CAPTION={name}
IG_DEFAULT_HASHTAGS=
IG_SHARE_TO_FEED=true

# --- رفتار انتشار ---
IG_DAILY_LIMIT=50
IG_POST_INTERVAL_SEC=45
IG_MAX_POSTS_PER_RUN=5
IG_ARCHIVE_AFTER_POST=false
IG_DRY_RUN=false

# --- دسترسی عمومی به فایل ویدیو (اجباری برای انتشار واقعی) ---
# آدرس تونل/دامنه‌ای که سرور محلی روی آن باز است، بدون / آخر
IG_PUBLIC_BASE_URL=
IG_MEDIA_PORT=8787
IG_MEDIA_HOST=0.0.0.0

# --- حالت رصد پوشه ---
IG_WATCH_INTERVAL_SEC=300

# --- اختیاری ---
# IG_FFPROBE=ffprobe
# IG_TOKEN_BASE_URL=https://graph.instagram.com
# IG_MEDIA_SECRET=یک-رشته-تصادفی-بلند
